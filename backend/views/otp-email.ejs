<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activate Your Account</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0f172a; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #f8fafc;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="table-layout: fixed;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #1e293b; border: 1px solid #334155; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
          <!-- Header -->
          <tr>
            <td align="center" style="background-color: #0f172a; padding: 30px 20px; border-bottom: 1px solid #334155;">
              <h1 style="margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.05em; color: #f59e0b;">
                <span style="color: #38bdf8; font-family: monospace;">&gt;_</span> Callback
              </h1>
            </td>
          </tr>
          
          <!-- Content Body -->
          <tr>
            <td style="padding: 40px 30px;">
              <h2 style="margin-top: 0; margin-bottom: 16px; font-size: 20px; font-weight: 600; color: #f8fafc;">Verify your email address</h2>
              <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #94a3b8;">
                Thank you for registering. Please enter the following 6-digit One-Time Password (OTP) on the verification page to activate your account:
              </p>
              
              <!-- OTP Display -->
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 30px 0;">
                <tr>
                  <td align="center">
                    <div style="display: inline-block; font-family: monospace; font-size: 32px; font-weight: 700; color: #f59e0b; background-color: #0f172a; padding: 16px 32px; border: 1px solid #334155; border-radius: 6px; letter-spacing: 8px;">
                      <%= otp %>
                    </div>
                  </td>
                </tr>
              </table>
              
              <p style="margin-bottom: 0; font-size: 14px; line-height: 1.6; color: #64748b;">
                This code is valid for 15 minutes and can only be used once. If you did not sign up for Callback, you can safely ignore this email.
              </p>
            </td>
          </tr>
          
          <!-- Footer -->
          <tr>
            <td align="center" style="padding: 24px 30px; background-color: #0f172a; border-top: 1px solid #334155;">
              <p style="margin: 0; font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">
                Callback Platform &middot; Automated System Message
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
